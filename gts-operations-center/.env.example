# ================================
# BANCO DE DADOS
# ================================
DATABASE_URL="postgresql://usuario:senha@host:5432/gts_operations"

# ================================
# AUTENTICAÇÃO
# ================================
NEXTAUTH_SECRET="uma_frase_bem_longa_e_segura_aqui_para_criptografia"
NEXTAUTH_URL="https://seu-dominio.exemplo.com"
AUTH_TRUST_HOST=true

# ================================
# API DE RASTREAMENTO
# ================================
RASTREAMENTO_API_URL="https://gtsnet.rastrosystem.com.br/api_v2"
RASTREAMENTO_API_TOKEN="seu-token-aqui"
RASTREAMENTO_API_USER="seu-usuario"
RASTREAMENTO_API_PASS="sua-senha"

# ================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ================================
NEXT_PUBLIC_APP_NAME="GTS Operations Center"
NEXT_PUBLIC_APP_URL="https://seu-dominio.exemplo.com"
NEXT_PUBLIC_SOCKET_URL="https://seu-dominio.exemplo.com"
NEXT_PUBLIC_MAP_REFRESH_INTERVAL=30000
NEXT_PUBLIC_VELOCIDADE_ALERTA=80

# ================================
# NOTIFICAÇÕES (SMTP + TELEGRAM)
# ================================
SMTP_HOST="smtp.seuservidor.com"
SMTP_PORT=587
SMTP_USER="seu@email.com"
SMTP_PASS="sua-senha-smtp"
SMTP_FROM="noreply@gtsnet.com.br"

TELEGRAM_BOT_TOKEN="seu-token-do-bot"
TELEGRAM_GROUP_OS="seu-id-de-grupo"

IXC_API_URL="https://ixc.exemplo.com.br/webservice/v1"
IXC_API_TOKEN="seu-token-ixc"
IXC_FIBERDOCS_USER="seu-usuario"
IXC_FIBERDOCS_PASS="sua-senha"

SMARTOLT_API_URL="https://seu-dominio.smartolt.com"
SMARTOLT_API_KEY="sua-chave-smartolt"

# --- Inteligencia Operacional (assistente de IA, somente leitura) ---
ORBIA_AI_ENABLED=true
# mock = respostas por regras (sem IA real, para testes) | openrouter = modelo gratuito do OpenRouter
ORBIA_AI_PROVIDER=mock
ORBIA_AI_READ_ONLY=true
ORBIA_AI_MAX_TOOL_CALLS=5
ORBIA_AI_REQUEST_TIMEOUT_MS=30000
# Limites de uso por usuario (opcionais)
# ORBIA_AI_RATE_PER_MINUTE=8
# ORBIA_AI_RATE_PER_DAY=200
# ORBIA_AI_MAX_INPUT_CHARS=1000
# ORBIA_AI_MAX_OUTPUT_TOKENS=900
# So usados com ORBIA_AI_PROVIDER=openrouter (a chave fica apenas no servidor):
OPENROUTER_API_KEY=
# Precisa terminar em ":free" e constar como gratuito na lista atual do OpenRouter, ex.: google/gemma-4-31b-it:free
OPENROUTER_MODEL=
# MCP: somente local (stdio). Nao existe endpoint publico; esta chave e' ignorada se for "true".
ORBIA_MCP_PUBLIC_ENABLED=false
# Usado so por "npm run ia:mcp": e-mail de um usuario ATIVO; o cliente MCP age com as permissoes dele.
# ORBIA_MCP_USER_EMAIL=
