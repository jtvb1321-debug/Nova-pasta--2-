generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GESTOR
  OPERADOR
  TECNICO
  VENDEDOR
  COMERCIAL
}

enum StatusEquipe {
  AGUARDANDO
  DESLOCAMENTO
  ATIVIDADE
  FINALIZADO
}

enum CategoriaEstoque {
  GTSNET
  EACE
  FERRAMENTAS
  LIMPEZA
  MANINFO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  RESERVA
  DEVOLUCAO
}

enum TipoChamado {
  INSTALACAO
  MANUTENCAO
  RETIRADA
  ROMPIMENTO_MASSIVO
  SUPORTE
}

enum StatusChamado {
  AGENDADO
  ABERTO
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
}

enum StatusVenda {
  PENDENTE
  APROVADO
  REPROVADO
}

enum StatusInstalacao {
  AGUARDANDO
  AGENDADA
  INSTALADA
  CANCELADA
}

enum StatusPosVenda {
  PENDENTE
  CONCLUIDO
}

enum StatusSolicitacao {
  PENDENTE
  APROVADO
  REPROVADO
  PAGO
  CANCELADO
}

enum CentroCusto {
  PROVEDOR
  EACE
  ADMINISTRATIVO
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  role      UserRole @default(OPERADOR)
  ativo     Boolean  @default(true)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendas       Venda[]
  logs         Log[]
  funcionario  Funcionario?
  solicitacoes SolicitacaoPagamento[] @relation("solicitacoes")
  aprovacoes   SolicitacaoPagamento[] @relation("aprovacoes")
  baixasRealizadas ContaReceber[]
  clientes     Cliente[]

  @@map("usuarios")
}

model Equipe {
  id          String       @id @default(cuid())
  nome        String
  status      StatusEquipe @default(AGUARDANDO)
  horaInicio  DateTime?
  localizacao String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

 funcionarios Funcionario[]
  chamados     Chamado[]
  veiculo      Veiculo?
  estoque      EstoqueEquipe[]
  usosMaterial UsoMaterial[]
  solicitacoesMaterial SolicitacaoMaterial[]
  escalas EscalaTrabalho[]
  diagnosticos Diagnostico[]
  unidadesEquipamento UnidadeEquipamento[]
  @@map("equipes")
}

model Funcionario {
  id        String   @id @default(cuid())
  nome      String
  cargo     String?
  telefone  String?
  avatar    String?
  ativo     Boolean  @default(true)
  equipeId  String
  usuarioId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipe   Equipe                 @relation(fields: [equipeId], references: [id])
  usuario  Usuario?               @relation(fields: [usuarioId], references: [id])
  despesas SolicitacaoPagamento[]
  registrosPonto RegistroPonto[]
  diagnosticos Diagnostico[]

  @@map("funcionarios")
}

model Veiculo {
  id           String   @id @default(cuid())
  placa        String   @unique
  modelo       String
  cor          String?
  ano          Int?
  equipeId     String?  @unique
  rastreadorId String?
  foto         String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

 equipe Equipe? @relation(fields: [equipeId], references: [id])
  abastecimentos Abastecimento[]
  registrosKm    RegistroKm[]
  manutencoes    SolicitacaoManutencao[]
  despesas       DespesaViagem[]
  @@map("veiculos")
}

model ItemEstoque {
  id               String           @id @default(cuid())
  codigo           String           @unique
  descricao        String
  categoria        CategoriaEstoque
  unidade          String           @default("UN")
  quantidadeAtual  Float            @default(0)
  quantidadeMinima Float            @default(0)
  fornecedor       String?
  valorUnitario    Float            @default(0)
  observacao       String?
  dataEntrada      DateTime         @default(now())
  ultimaMovimento  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  movimentacoes       Movimentacao[]
  materiaisUtilizados MaterialUtilizado[]
  materiaisDevolvidos MaterialDevolvido[]
  materiaisReservados MaterialReservado[]
  estoqueEquipes      EstoqueEquipe[]
  usosMaterial   UsoMaterial[]
  reversas       ReversaEstoque[]
  solicitacoesMaterial SolicitacaoMaterial[]
  entradasDefeito EntradaDefeito[]
  saldosLocais    EstoqueLocalCentral[]
  unidadesEquipamento UnidadeEquipamento[]
  @@map("estoques")
}

enum StatusUnidadeEquipamento {
  EM_ESTOQUE
  UTILIZADA
}

// Rastreio por unidade (MAC) para itens que o operador escolher ler
// individualmente ao carregar na equipe - convive com EstoqueEquipe.quantidade
// (que continua sendo a soma agregada, mantida em sincronia a cada unidade
// criada/consumida) para nao quebrar telas/relatorios que so leem a soma.
model UnidadeEquipamento {
  id         String                   @id @default(cuid())
  itemId     String
  macAddress String                   @unique
  equipeId   String
  status     StatusUnidadeEquipamento @default(EM_ESTOQUE)
  chamadoId  String?
  usadoPor   String?
  usadoEm    DateTime?
  createdAt  DateTime                 @default(now())

  item    ItemEstoque @relation(fields: [itemId], references: [id])
  equipe  Equipe      @relation(fields: [equipeId], references: [id])
  chamado Chamado?    @relation(fields: [chamadoId], references: [id])

  @@map("unidades_equipamento")
}
model Movimentacao {
  id         String           @id @default(cuid())
  itemId     String
  tipo       TipoMovimentacao
  quantidade Float
  valorUnit  Float?
  motivo     String?
  chamadoId  String?
  operadorId String?
  createdAt  DateTime         @default(now())

  item    ItemEstoque @relation(fields: [itemId], references: [id])
  chamado Chamado?    @relation(fields: [chamadoId], references: [id])

  @@map("movimentacoes")
}

model Chamado {
  id           String        @id @default(cuid())
  cliente      String
  endereco     String
  numero       String?
  complemento  String?
  bairro       String?
  condominio   String?
  bloco        String?
  apartamento  String?
  cep          String?
  cidade       String
  uf           String?
  telefone     String?
  tipo         TipoChamado
  observacao   String?
  relato       String?
  fotos        String?
  equipeId     String?
  status       StatusChamado @default(ABERTO)
 dataAbertura DateTime      @default(now())
  dataAgendada DateTime?
  agendadoPor  String?
  dataACaminho DateTime?
  dataInicio   DateTime?
  dataFim      DateTime?
  clienteAusente    Boolean   @default(false)
  horarioRedisparo  DateTime?
  fechadoAdmin      Boolean   @default(false)
  feedbackEnviado   Boolean   @default(false)
  feedbackEnviadoEm DateTime?
  feedbackResposta     String?
  feedbackRespostaEm   DateTime?
  feedbackConfirmado   Boolean   @default(false)
  feedbackConfirmadoEm DateTime?
  feedbackConfirmadoPor String?
  aguardandoAprovacao Boolean   @default(false)
  aprovadoPor          String?
  aprovadoEm           DateTime?
  origemAutomatica     String?
  clientesAfetados     Int?
  subCategoria         String?
  idOnuSmartOlt        String?
  slaRespostaMinutos    Int?
  slaResolucaoMinutos   Int?
  dentroSlaResposta     Boolean?
  dentroSlaResolucao    Boolean?
  reincidente           Boolean   @default(false)
  chamadoOrigemReincidenciaId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  equipe              Equipe?             @relation(fields: [equipeId], references: [id])
  movimentacoes       Movimentacao[]
  materiaisUtilizados MaterialUtilizado[]
  materiaisDevolvidos MaterialDevolvido[]
  materiaisReservados MaterialReservado[]
  usosMaterial        UsoMaterial[]
  diagnosticos        Diagnostico[]
  unidadesEquipamento UnidadeEquipamento[]

  @@map("chamados")
}

model MaterialReservado {
  id         String   @id @default(cuid())
  chamadoId  String
  itemId     String
  quantidade Float
  createdAt  DateTime @default(now())

  chamado Chamado     @relation(fields: [chamadoId], references: [id])
  item    ItemEstoque @relation(fields: [itemId], references: [id])

  @@map("materiais_reservados")
}

model MaterialUtilizado {
  id         String   @id @default(cuid())
  chamadoId  String
  itemId     String
  quantidade Float
  observacao String?
  createdAt  DateTime @default(now())

  chamado Chamado     @relation(fields: [chamadoId], references: [id])
  item    ItemEstoque @relation(fields: [itemId], references: [id])

  @@map("materiais_utilizados")
}

model MaterialDevolvido {
  id          String    @id @default(cuid())
  chamadoId   String
  itemId      String
  quantidade  Float
  observacao  String?
  aprovado    Boolean   @default(false)
  aprovadoPor String?
  aprovadoEm  DateTime?
  createdAt   DateTime  @default(now())

  chamado Chamado     @relation(fields: [chamadoId], references: [id])
  item    ItemEstoque @relation(fields: [itemId], references: [id])

  @@map("materiais_devolvidos")
}

enum FaseDiagnostico {
  ANTES
  DEPOIS
}

enum StatusDiagnostico {
  EM_ANDAMENTO
  CONCLUIDO
}

enum ClassificacaoDiagnostico {
  NORMAL
  ATENCAO
  POSSIVEL_PROBLEMA
  PROBLEMA
  INDETERMINADO
}

// Diagnostico tecnico de conexao (Wi-Fi/velocidade/latencia/sinal optico)
// rodado pelo tecnico em campo, vinculado a um Chamado. Um par ANTES/DEPOIS
// na mesma OS permite comparar o resultado antes e depois da manutencao.
model Diagnostico {
  id                     String                    @id @default(cuid())
  chamadoId              String
  funcionarioId          String?
  equipeId               String?
  fase                   FaseDiagnostico           @default(ANTES)
  diagnosticoAnteriorId  String?                   @unique
  status                 StatusDiagnostico         @default(EM_ANDAMENTO)
  dispositivoUtilizado   String?
  classificacao          ClassificacaoDiagnostico?
  origemProvavel         String?
  recomendacoes          Json?
  resumo                 Json?
  problemaEncontrado     String?
  acaoRealizada          String?
  equipamentoSubstituido Boolean                   @default(false)
  equipamentoAntigoDesc  String?
  equipamentoNovoDesc    String?
  resultadoFinal         String?
  iniciadoPor            String?
  iniciadoEm             DateTime                  @default(now())
  finalizadoEm           DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  chamado              Chamado            @relation(fields: [chamadoId], references: [id])
  funcionario          Funcionario?       @relation(fields: [funcionarioId], references: [id])
  equipe               Equipe?            @relation(fields: [equipeId], references: [id])
  diagnosticoAnterior  Diagnostico?       @relation("AntesDepois", fields: [diagnosticoAnteriorId], references: [id])
  diagnosticoPosterior Diagnostico?       @relation("AntesDepois")
  testes               DiagnosticoTeste[]

  @@map("diagnosticos")
}

model DiagnosticoTeste {
  id            String   @id @default(cuid())
  diagnosticoId String
  tipo          String
  status        String
  valor         Float?
  unidade       String?
  duracaoMs     Int?
  detalhes      Json?
  erro          String?
  createdAt     DateTime @default(now())

  diagnostico Diagnostico @relation(fields: [diagnosticoId], references: [id])

  @@map("diagnostico_testes")
}

// Configuracao unica (id fixo "default") dos limiares usados pelo motor de
// diagnostico - evita hardcode no codigo, ajustavel pelo admin.
model ConfiguracaoDiagnostico {
  id                          String   @id @default("default")
  limiteJitterAtencaoMs       Float    @default(20)
  limiteJitterProblemaMs      Float    @default(50)
  limitePerdaAtencaoPct       Float    @default(1)
  limitePerdaInstabilidadePct Float    @default(3)
  limiteLatenciaAtencaoMs     Float    @default(60)
  limiteLatenciaProblemaMs    Float    @default(120)
  limiteSinalAtencaoDbm       Float    @default(-25)
  limiteSinalCriticoDbm       Float    @default(-28)
  duracaoOscilacaoPadraoSeg   Int      @default(60)
  updatedAt                   DateTime @updatedAt

  @@map("configuracoes_diagnostico")
}

model Cliente {
  id                String        @id @default(cuid())
  codigoIxc         String?       @unique
  nome              String
  cpfCnpj           String?
  telefone          String?
  cidade            String?
  uf                String?
  bairro            String?
  email             String?
  endereco          String?
  numero            String?
  complemento       String?
  bloco             String?
  apartamento       String?
  cep               String?
  plano             String?
  valorMensalidade  Float?
  vendedorId        String?
  dataAtivacao      DateTime?
  status            StatusCliente @default(ATIVO)
  materialRecolhido Boolean       @default(false)
  setorCobranca     Boolean       @default(false)
  observacao        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  vendas        Venda[]
  vendedor      Usuario?       @relation(fields: [vendedorId], references: [id])
  contasReceber ContaReceber[]

  @@map("clientes")
}

enum StatusCliente {
  ATIVO
  INATIVO
  CANCELADO
}

enum StatusContaReceber {
  PENDENTE
  PAGO
  CANCELADO
}

enum FormaPagamentoCliente {
  PIX
  DINHEIRO
  BOLETO
  CARTAO
}

model ContaReceber {
  id             String                 @id @default(cuid())
  clienteId      String
  competencia    DateTime
  valor          Float
  status         StatusContaReceber     @default(PENDENTE)
  formaPagamento FormaPagamentoCliente?
  banco          String?
  valorRecebido  Float?
  troco          Float?
  dataPagamento  DateTime?
  recebidoPor    String?
  observacao     String?
  idTituloIxc    String?                @unique
  origemBaixa    String?                @default("MANUAL")
  dataVencimento DateTime?
  valorJuros     Float?
  valorDesconto  Float?
  statusIxc      String?
  dataBaixaIxc   DateTime?
  usuarioIdBaixa String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id])
  usuarioBaixa Usuario? @relation(fields: [usuarioIdBaixa], references: [id])

  @@unique([clienteId, competencia])
  @@map("contas_receber")
}

model Venda {
  id               String           @id @default(cuid())
  clienteId        String?
  clienteNome      String
  clienteCpfCnpj   String?
  telefone         String?
  endereco         String?
  cidade           String?
  bairro           String?
  planoVendido     String
  valor            Float
  data             DateTime         @default(now())
  dataInstalacao   DateTime?
  statusInstalacao StatusInstalacao @default(AGUARDANDO)
  statusPosVenda   StatusPosVenda   @default(PENDENTE)
  posVendaData     DateTime?
  posVendaResp     String?
  posVendaObs      String?
  posVendaImagem   String?
  observacoes      String?
  status           StatusVenda      @default(PENDENTE)
  vendedorId       String
  aprovadoPor      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  vendedor Usuario  @relation(fields: [vendedorId], references: [id])
  cliente  Cliente? @relation(fields: [clienteId], references: [id])
  comissao Comissao?

  @@map("vendas")
}

model Comissao {
  id        String    @id @default(cuid())
  vendaId   String    @unique
  valor     Float     @default(25.00)
  pago      Boolean   @default(false)
  dataPago  DateTime?
  createdAt DateTime  @default(now())

  venda Venda @relation(fields: [vendaId], references: [id])

  @@map("comissoes")
}

// Dados de monitoramento de clientes de Link Dedicado que nao vem disponiveis
// via IXC/SmartOLT e precisam ser preenchidos manualmente (IP e potencia optica).
model MonitoramentoLinkDedicado {
  id               String    @id @default(cuid())
  codigoIxc        String    @unique
  ipManual         String?
  potenciaRxManual Float?
  potenciaTxManual Float?
  observacao       String?
  atualizadoPor    String?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())

  @@map("monitoramento_link_dedicado")
}

model Configuracao {
  id        String   @id @default(cuid())
  chave     String   @unique
  valor     String
  descricao String?
  updatedAt DateTime @updatedAt

  @@map("configuracoes")
}

// Snapshot periodico (a cada 15min) de metricas operacionais - alimenta os
// sparklines e o comparativo "vs ontem" do Dashboard com dados reais que se
// acumulam com o tempo (nao ha historico anterior a criacao desse model).
model SnapshotMetricaDashboard {
  id                     String   @id @default(cuid())
  timestamp              DateTime @default(now())
  clientesOnline         Int
  clientesOffline        Int
  onusTotal              Int
  oltsTotal              Int
  chamadosAbertos        Int
  chamadosAndamento      Int
  tecnicosOnline         Int
  slaResolucaoPercentual Float?

  @@map("snapshots_metricas_dashboard")
}

model Log {
  id         String   @id @default(cuid())
  usuarioId  String?
  acao       String
  entidade   String?
  entidadeId String?
  detalhes   String?
  ip         String?
  createdAt  DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("logs")
}

model SolicitacaoPagamento {
  id             String            @id @default(cuid())
  titulo         String
  descricao      String?
  centroCusto    CentroCusto
  subcategoria   String
  valor          Float
  valorPago      Float?
  fornecedor     String?
  tecnicoId      String?
  responsavelId  String
  aprovadorId    String?
  status         StatusSolicitacao @default(PENDENTE)
  dataVencimento DateTime?
  dataPagamento  DateTime?
  notaFiscal     String?
  anexos         String?
  observacoes    String?
  parcelas       Int               @default(1)
  parcelaAtual   Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  responsavel Usuario              @relation("solicitacoes", fields: [responsavelId], references: [id])
  aprovador   Usuario?             @relation("aprovacoes",   fields: [aprovadorId],  references: [id])
  tecnico     Funcionario?         @relation(fields: [tecnicoId], references: [id])
  historico   HistoricoFinanceiro[]

  @@map("solicitacoes_pagamento")
}

model HistoricoFinanceiro {
  id            String   @id @default(cuid())
  solicitacaoId String
  usuarioId     String?
  acao          String
  descricao     String?
  createdAt     DateTime @default(now())

  solicitacao SolicitacaoPagamento @relation(fields: [solicitacaoId], references: [id])

  @@map("historico_financeiro")
}

model OrcamentoFinanceiro {
  id          String      @id @default(cuid())
  centroCusto CentroCusto
  mes         Int
  ano         Int
  valorTotal  Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([centroCusto, mes, ano])
  @@map("orcamentos_financeiros")
}
enum StatusManutencao {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model EstoqueEquipe {
  id                String   @id @default(cuid())
  equipeId          String
  itemId            String
  quantidade        Float    @default(0)
  quantidadeMinima  Float    @default(0)
  updatedAt         DateTime @updatedAt

  equipe Equipe      @relation(fields: [equipeId], references: [id])
  item   ItemEstoque @relation(fields: [itemId], references: [id])

  @@unique([equipeId, itemId])
  @@map("estoque_equipes")
}

model Abastecimento {
  id             String   @id @default(cuid())
  veiculoId      String
  data           DateTime @default(now())
  litros         Float
  valor          Float
  fotoComprovante String
  registradoPor  String
  createdAt      DateTime @default(now())

  veiculo Veiculo @relation(fields: [veiculoId], references: [id])

  @@map("abastecimentos")
}


enum TipoDespesaViagem {
  ALIMENTACAO
  HOSPEDAGEM
  ALUGUEL_VEICULO
  OUTRAS
}

enum StatusDespesaViagem {
  PENDENTE
  APROVADO
  REJEITADO
}

model DespesaViagem {
  id                String              @id @default(cuid())
  veiculoId         String
  tipo              TipoDespesaViagem
  data              DateTime            @default(now())
  valor             Float?
  fotoComprovante   String
  registradoPor     String
  status            StatusDespesaViagem @default(PENDENTE)
  revisadoPor       String?
  revisadoEm        DateTime?
  observacaoRevisao String?
  createdAt         DateTime            @default(now())

  veiculo Veiculo @relation(fields: [veiculoId], references: [id])

  @@map("despesas_viagem")
}

model UsoMaterial {
  id            String   @id @default(cuid())
  equipeId      String
  itemId        String
  quantidade    Float
  fotoMac       String
  chamadoId     String?
  clienteNome   String?
  registradoPor String
  createdAt     DateTime @default(now())

  equipe  Equipe      @relation(fields: [equipeId], references: [id])
  item    ItemEstoque @relation(fields: [itemId], references: [id])
  chamado Chamado?    @relation(fields: [chamadoId], references: [id])

  @@map("usos_material")
}

model ReversaEstoque {
  id            String   @id @default(cuid())
  itemId        String
  quantidade    Float
  data          DateTime @default(now())
  observacao    String?
  registradoPor String
  createdAt     DateTime @default(now())

  item ItemEstoque @relation(fields: [itemId], references: [id])

  @@map("reversas_estoque")
}
enum OrigemEntradaDefeito {
  TECNICO
  CLIENTE
  DIRETA
}

enum StatusEntradaDefeito {
  PENDENTE_ACEITE
  ACEITO
}

model EntradaDefeito {
  id            String               @id @default(cuid())
  itemId        String
  quantidade    Float
  numeroSerie   String?
  defeito       String
  origem        OrigemEntradaDefeito
  tecnicoNome   String?
  status        StatusEntradaDefeito @default(PENDENTE_ACEITE)
  registradoPor String
  aceitoPor     String?
  aceitoEm      DateTime?
  createdAt     DateTime             @default(now())

  item ItemEstoque @relation(fields: [itemId], references: [id])
  @@map("entradas_defeito")
}


model LocalEstoque {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  saldos EstoqueLocalCentral[]

  @@map("locais_estoque")
}

model EstoqueLocalCentral {
  id         String   @id @default(cuid())
  localId    String
  itemId     String
  quantidade Float    @default(0)
  updatedAt  DateTime @updatedAt

  local LocalEstoque @relation(fields: [localId], references: [id])
  item  ItemEstoque  @relation(fields: [itemId], references: [id])

  @@unique([localId, itemId])
  @@map("estoque_local_central")
}

model RegistroKm {
  id            String    @id @default(cuid())
  veiculoId     String
  data          DateTime  @default(now())
  kmInicial     Float?
  kmFinal       Float?
  registradoPor String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  veiculo Veiculo @relation(fields: [veiculoId], references: [id])

  @@map("registros_km")
}

model SolicitacaoManutencao {
  id            String            @id @default(cuid())
  veiculoId     String
  descricao     String
  status        StatusManutencao  @default(PENDENTE)
  solicitadoPor String
  resolvidoEm   DateTime?
  observacao    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  veiculo Veiculo @relation(fields: [veiculoId], references: [id])

  @@map("solicitacoes_manutencao")
}

enum StatusSolicitacaoMaterial {
  PENDENTE
  APROVADA
  REJEITADA
}

model SolicitacaoMaterial {
  id            String                    @id @default(cuid())
  equipeId      String
  itemId        String
  quantidade    Float
  observacao    String?
  status        StatusSolicitacaoMaterial @default(PENDENTE)
  solicitadoPor String
  resolvidoPor  String?
  resolvidoEm   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  equipe Equipe      @relation(fields: [equipeId], references: [id])
  item   ItemEstoque @relation(fields: [itemId], references: [id])

  @@map("solicitacoes_material")
}
enum StatusHorasExtras {
  PENDENTE
  APROVADA
  REJEITADA
  SEM_EXTRA
}

model RegistroPonto {
  id                String            @id @default(cuid())
  funcionarioId     String
  data              DateTime          @default(now())
  entrada           DateTime?
  saidaAlmoco       DateTime?
  retornoAlmoco     DateTime?
  saida             DateTime?
  horasTrabalhadas  Float?
  horasExtras       Float?
  statusHorasExtras StatusHorasExtras @default(SEM_EXTRA)
  aprovadoPor       String?
  aprovadoEm        DateTime?
  observacao        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])

  @@unique([funcionarioId, data])
  @@map("registros_ponto")
}
enum TipoEscala {
  TRABALHO
  FOLGA
  PLANTAO_SABADO
}

model EscalaTrabalho {
  id         String     @id @default(cuid())
  equipeId   String
  data       DateTime
  tipo       TipoEscala
  observacao String?
  criadoPor  String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  equipe Equipe @relation(fields: [equipeId], references: [id])

  @@unique([equipeId, data])
  @@map("escalas_trabalho")
}